# Plantilla de .streamlit/secrets.toml (el archivo real NO se sube al repositorio).
#
# 1. Copie este archivo como .streamlit/secrets.toml
# 2. Cambie MATERNA_SAL por una cadena aleatoria propia, por ejemplo la que imprime:
#        python -c "import secrets; print(secrets.token_urlsafe(32))"
#    Guárdela bien: si se pierde, los seudónimos nuevos no coincidirán con los anteriores.
# 3. Cree los usuarios desde la terminal (pide la contraseña sin mostrarla y agrega el bloque aquí):
#        python -m src.autenticacion crear-usuario admin --rol administrador --nombre "Administrador"
#        python -m src.autenticacion crear-usuario medico --rol medico_auditor --nombre "Médico auditor"
#    Roles: administrador (todo, incluido reentrenar) y medico_auditor (audita e ingiere archivos reales
#    de la IPS; no reentrena).

MATERNA_SAL = "cambie-esta-cadena-por-una-aleatoria-de-32-caracteres"

# Ejemplo de bloque que agrega el comando (no copie este hash: no corresponde a ninguna contraseña)
# [usuarios.admin]
# nombre = "Administrador"
# rol = "administrador"
# hash = "scrypt$16384$8$1$<sal>$<hash>"

# ---------------------------------------------------------------- «¿Olvidó su contraseña?» (opcional)
# 4. Asigne a cada usuario el correo donde recibirá el código (agrega la línea  correo = "..."  a su bloque):
#        python -m src.autenticacion correo admin persona@ejemplo.com
# 5. Configure la cuenta que envía los correos. En Gmail: active la verificación en dos pasos y cree una
#    «Contraseña de aplicación» (16 caracteres); esa va en «clave», nunca la contraseña normal de la cuenta.
#    Sin esta sección, el enlace del login explica que la recuperación no está configurada.
# [correo]
# servidor = "smtp.gmail.com"
# puerto = 587                      # 587 = STARTTLS; 465 = SSL directo
# usuario = "cuenta.materna@gmail.com"
# clave = "xxxx xxxx xxxx xxxx"
# remitente = "MATERNA <cuenta.materna@gmail.com>"
